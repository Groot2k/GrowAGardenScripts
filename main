-- Load Library UI (Axon / WindUI Style)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Axon Hub | Grow a Chicken Fighter",
   LoadingTitle = "Axon Hub",
   LoadingSubtitle = "by kokmoxXx",
   ConfigurationSaving = {
      Enabled = false
   },
   KeySystem = false -- Tanpa Key System
})

---------------------------------------------------------
-- TAB 1: MONEY FARM
---------------------------------------------------------
local MoneyFarmTab = Window:CreateTab("Money Farm", 4483362458)

local SectionFarm = MoneyFarmTab:CreateSection("One-Switch Farming")

local ToggleMoneyFarm = MoneyFarmTab:CreateToggle({
   Name = "Automatic Money Farm",
   CurrentValue = false,
   Callback = function(Value)
      -- Logic Auto Money Farm di sini
      _G.AutoMoneyFarm = Value
      task.spawn(function()
         while _G.AutoMoneyFarm do
            task.wait(0.1)
            -- Code farm
         end
      end)
   end,
})

local ToggleWorldPickups = MoneyFarmTab:CreateToggle({
   Name = "Include World Pickups",
   CurrentValue = false,
   Callback = function(Value)
      _G.IncludePickups = Value
   end,
})

local SliderFarmDelay = MoneyFarmTab:CreateSlider({
   Name = "Farm Cycle Delay",
   Range = {0, 100},
   Increment = 1,
   Suffix = "s",
   CurrentValue = 20,
   Callback = function(Value)
      _G.FarmDelay = Value
   end,
})

local SectionIncubator = MoneyFarmTab:CreateSection("Incubator")

local ToggleIncubator = MoneyFarmTab:CreateToggle({
   Name = "Automatic Incubator",
   CurrentValue = false,
   Callback = function(Value)
      _G.AutoIncubator = Value
   end,
})

local ToggleIncubatorUpgrades = MoneyFarmTab:CreateToggle({
   Name = "Automatic Incubator Upgrades",
   CurrentValue = true,
   Callback = function(Value)
      _G.AutoIncubatorUpgrades = Value
   end,
})

local SliderIncubatorReserve = MoneyFarmTab:CreateSlider({
   Name = "Incubator Money Reserve",
   Range = {0, 1000000},
   Increment = 1000,
   Suffix = "$",
   CurrentValue = 0,
   Callback = function(Value)
      _G.IncubatorReserve = Value
   end,
})

