   Callback = function(Value)
      _G.AutoCoopImprovement = Value
   end,
})

local DropdownImpTypes = CoopTab:CreateDropdown({
   Name = "Improvement Types",
   Options = {"Buy Generator", "Upgrade Generator", "Expand Slots"},
   CurrentOption = {"Buy Generator"},
   MultipleOptions = true,
   Callback = function(Options)
      _G.ImprovementTypes = Options
   end,
})

local SliderKeepMoney = CoopTab:CreateSlider({
   Name = "Keep Money Above",
   Range = {0, 10000000},
   Increment = 50000,
   Suffix = "$",
   CurrentValue = 0,
   Callback = function(Value)
      _G.KeepMoneyAbove = Value
   end,
})

local SliderTimeImp = CoopTab:CreateSlider({
   Name = "Time Between Improvements",
   Range = {0.1, 10},
   Increment = 0.1,
   Suffix = "s",
   CurrentValue = 0.5,
   Callback = function(Value)
