-- TAB 5: WEBHOOKS
---------------------------------------------------------
local WebhooksTab = Window:CreateTab("Webhooks", 4483362458)

local SectionWebhook = WebhooksTab:CreateSection("Discord Webhook")

local InputWebhook = WebhooksTab:CreateInput({
   Name = "Discord Webhook URL",
   PlaceholderText = "https://discord.com/api/webhooks/...",
   RemoveTextOnFocus = false,
   Callback = function(Text)
      _G.WebhookURL = Text
   end,
})

local ToggleWebhookNotif = WebhooksTab:CreateToggle({
   Name = "Send Webhook Notifications",
   CurrentValue = false,
   Callback = function(Value)
      _G.SendWebhook = Value
   end,
})

local ToggleSecretAlerts = WebhooksTab:CreateToggle({
   Name = "Secret Chicken Alerts",
   CurrentValue = false,
   Callback = function(Value)
      _G.SecretAlerts = Value
   end,
})
